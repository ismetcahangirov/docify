# Copy to `.env` and fill in. `.gitignore` keeps `.env` out of the history and
# lets this file through, so a variable that exists only in a deployment
# dashboard is a variable the next environment forgets to set.
#
# Every one of these is optional. The application builds, runs and serves every
# page with none of them set — see docs/backend/neon-provisioning.md for what
# each one turns on and what happens in its absence.

# Deployment runbooks: docs/deploy/vercel.md, docs/backend/render-deploy.md.

# Neon, for the anonymous conversion counters behind /api/stats.
# Use the *pooled* connection string (the host contains `-pooler`).
# Unset: the counters are skipped and every route still works. Issue #101.
DATABASE_URL=
